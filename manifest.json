{
  "manifest_version": 3,
  "name": "Gmail CRM",
  "version": "1.4.0",
  "description": "A powerful CRM and Surgical Case Log that lives within Gmail. Manage deals, contacts, pipelines, and log surgical cases with AI-powered text parsing. Export to ABNS, ACGME, and other surgical society formats.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://mail.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["sidebar.html", "icons/*"],
      "matches": ["https://mail.google.com/*"]
    }
  ]
}
