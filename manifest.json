{
  "manifest_version": 3,
  "name": "Effortless - Gmail CRM",
  "version": "2.5.0",
  "description": "Effortless CRM with powerful voice control. Manage deals, contacts, and pipelines directly from your Gmail inbox using natural voice commands.",
  "permissions": [
    "storage",
    "activeTab",
    "identity",
    "alarms"
  ],
  "oauth2": {
    "client_id": "892135221790-vrbs0kmib5uosbafqsmeb4tlnsq9hc1o.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "host_permissions": [
    "https://mail.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["leaflet/leaflet.js", "firebase-integration.js", "voice-control.js", "content.js"],
      "css": ["leaflet/leaflet.css", "styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["sidebar.html", "icons/*", "leaflet/*"],
      "matches": ["https://mail.google.com/*"]
    }
  ]
}
